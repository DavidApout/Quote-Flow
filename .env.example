# Development defaults. Visit this exact origin in the browser.
PORT=5173
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
# Optional absolute path on a persistent disk:
# DATABASE_PATH=/your/persistent/disk/quoteflow.sqlite
# Production: set APP_ORIGIN to your public https:// URL and configure an HTTPS
# reverse proxy. Set HOST=0.0.0.0 only when required by your hosting provider.

# Server-only OpenAI configuration. Never use a VITE_ prefix for this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Email notifications. Development defaults to preview (no outbound email).
# Production defaults to disabled and will not permit preview mode.
# Choose resend only after verifying a sender domain with the provider.
# MAIL_MODE=preview
# MAIL_MODE=resend
# RESEND_API_KEY=
# MAIL_FROM=QuoteFlow <quotes@your-verified-domain.example>
# Configure this same secret for the Resend webhook at:
# https://your-domain.example/api/mail/webhook
# RESEND_WEBHOOK_SECRET=

# Optional sandbox-only PayPal checkout. Keep credentials server-side.
# One demo business is bound to one sandbox merchant (no merchant onboarding).
# PAYPAL_SANDBOX_CLIENT_ID=
# PAYPAL_SANDBOX_CLIENT_SECRET=
# PAYPAL_SANDBOX_MERCHANT_ID=
# PAYPAL_DEMO_BUSINESS_ID=
